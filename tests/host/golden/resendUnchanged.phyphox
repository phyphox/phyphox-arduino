<phyphox version="1.20">
<title>Resend</title>
<category>Arduino Experiments</category>
<description>1.x behaviour</description>
<data-containers>
	<container size="0">CH0</container>
	<container size="0">CH1</container>
	<container size="0">CH2</container>
	<container size="0">CH3</container>
	<container size="0">CH4</container>
	<container size="0">CH5</container>
	<container size="1">in1</container>
</data-containers>
<input>
	<bluetooth name="phyphox-Arduino" id="phyphoxBLE" mode="notification" subscribeOnStart="false">
		<output char="cddf1002-30f7-4671-8b43-5e40ba53514a" conversion="float32LittleEndian" offset="0" repeating="4">CH1</output>
		<output char="cddf1002-30f7-4671-8b43-5e40ba53514a" conversion="float32LittleEndian" offset="4" repeating="4">CH2</output>
		<output char="cddf1002-30f7-4671-8b43-5e40ba53514a" conversion="float32LittleEndian" offset="8" repeating="4">CH3</output>
		<output char="cddf1002-30f7-4671-8b43-5e40ba53514a" conversion="float32LittleEndian" offset="12" repeating="4">CH4</output>
		<output char="cddf1002-30f7-4671-8b43-5e40ba53514a" conversion="float32LittleEndian" offset="16" repeating="4">CH5</output>
		<output char="cddf1002-30f7-4671-8b43-5e40ba53514a" extra="time">CH0</output>
	</bluetooth>
</input>
<output>
	<bluetooth id="phyphoxBLE" name="phyphox-Arduino">
		<input char="cddf2001-30f7-4671-8b43-5e40ba53514a" conversion="float32LittleEndian">in1</input>
	</bluetooth>
</output>
<analysis sleep="0" onUserInput="true">
</analysis>
<views>
	<view label="V">
		<slider label="S" minValue="0" maxValue="10" stepSize="1">
			<output>in1</output>
		</slider>
	</view>
</views>
<export>
	<set name="mySet">
		<data name="myData0">CH0</data>
		<data name="myData1">CH1</data>
		<data name="myData2">CH2</data>
		<data name="myData3">CH3</data>
		<data name="myData4">CH4</data>
		<data name="myData5">CH5</data>
	</set>
</export>
</phyphox>
